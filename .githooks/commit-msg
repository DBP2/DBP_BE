#!/bin/sh
# 커밋 형식 검사 (FE commitlint 와 동일 규칙)
# 형식: "타입: 제목"  예) feat: SafeZoneDAO 구현
msg_file="$1"
header=$(head -n 1 "$msg_file")

# git 이 자동으로 만드는 메시지는 통과
case "$header" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

types="feat|fix|style|refactor|chore|docs|test|revert"
if ! printf '%s' "$header" | grep -Eq "^($types): .+"; then
  echo ""
  echo "❌ 커밋 메시지 형식이 올바르지 않습니다."
  echo "   형식: 타입: 제목   (타입: $types)"
  echo "   예시: feat: SafeZoneDAO 조회 메소드 구현"
  echo "   입력: $header"
  echo ""
  exit 1
fi

len=$(printf '%s' "$header" | wc -m)
if [ "$len" -gt 100 ]; then
  echo "❌ 커밋 제목은 100자 이하로 작성해주세요. (현재 ${len}자)"
  exit 1
fi
exit 0
